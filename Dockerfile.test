# Test Dockerfile for Open-Guardian v0.2.0
# Usage: docker build -f Dockerfile.test .

FROM rust:1.88-slim AS builder

WORKDIR /usr/src/open-guardian

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt clippy

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src
COPY rules ./rules

# Every gate is mandatory.
RUN cargo fmt -- --check
RUN cargo test --all-targets --locked 2>&1 | tee test.log
RUN cargo clippy --all-targets -- -D warnings
RUN cargo build --release --locked 2>&1 | tee build.log

# Final verification stage
FROM debian:bookworm-slim
WORKDIR /app

# Copy built binary
COPY --from=builder /usr/src/open-guardian/target/release/open-guardian /usr/local/bin/
COPY --from=builder /usr/src/open-guardian/build.log /app/
COPY --from=builder /usr/src/open-guardian/test.log /app/

# Install runtime deps
RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

# Verify the CLI without starting a network listener.
RUN open-guardian --help

CMD ["open-guardian", "--help"]
