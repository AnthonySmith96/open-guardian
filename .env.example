# Open-GuardIAn Environment Variables
# Copy to .env and fill in your values

# API Keys for upstream providers
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-key-here

# HMAC key for rule file integrity verification
# Generate a strong random key for production use
GUARDIAN_HMAC_KEY=change-me-to-a-strong-secret

# Optional: skip integrity checks (dev only, never in production)
# GUARDIAN_SKIP_INTEGRITY=true

# Optional: custom rules directory path
# GUARDIAN_RULES_DIR=rules
